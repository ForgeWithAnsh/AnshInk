rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "forgewithansh@gmail.com"
        && request.auth.token.email_verified == true;
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function orderEmailMatches(orderId, email) {
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return order.email == email
        || get(/databases/$(database)/documents/users/$(order.uid)).data.email == email;
    }

    match /users/{uid} {
      allow read, write: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    match /metadata/orderCounter {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.value == 1;
      allow update: if signedIn() && request.resource.data.value == resource.data.value + 1;
    }

    match /gallery/{sketchId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'category', 'description', 'photos', 'legacyId', 'createdAt', 'featured'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.category in ['human', 'other']
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 120
        && request.resource.data.photos is list
        && request.resource.data.photos.size() > 0
        && request.resource.data.photos.size() <= 4
        && request.resource.data.photos[0] is string
        && request.resource.data.photos[0].size() <= 900000
        && (request.resource.data.photos.size() < 2
          || (request.resource.data.photos[1] is string && request.resource.data.photos[1].size() <= 900000))
        && (request.resource.data.photos.size() < 3
          || (request.resource.data.photos[2] is string && request.resource.data.photos[2].size() <= 900000))
        && (request.resource.data.photos.size() < 4
          || (request.resource.data.photos[3] is string && request.resource.data.photos[3].size() <= 900000))
        && request.resource.data.createdAt is int
        && (!('featured' in request.resource.data) || request.resource.data.featured is bool)
        && (!('legacyId' in request.resource.data)
          || request.resource.data.legacyId == null
          || request.resource.data.legacyId in ['j', 'e', 'c', 'a', 'b', 'd']);
      allow update, delete: if isAdmin();
    }

    // Documents in this collection are consumed by Firebase's Trigger Email extension.
    // Customers can only queue one notification per own order, addressed to the artist.
    match /mail/{mailId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'orderId', 'message'])
        && request.resource.data.orderId is string
        && request.resource.data.message.subject is string
        && request.resource.data.message.text is string
        && request.resource.data.message.html is string
        && ((request.resource.data.to == 'forgewithansh@gmail.com'
             && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.uid == request.auth.uid
             && mailId == 'order-' + request.resource.data.orderId)
            || (isAdmin() && orderEmailMatches(request.resource.data.orderId, request.resource.data.to)));
      allow read, update, delete: if isAdmin();
    }

    match /reviews/{rid} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.s is int
        && request.resource.data.s >= 1 && request.resource.data.s <= 5
        && request.resource.data.x.size() <= 500;
      allow delete: if isAdmin();
    }

    match /orders/{oid} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.st == 0;
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.st == 0 && request.resource.data.st == -4
            && onlyChanges(['st']))
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.st == 2 && request.resource.data.rf == 'req'
            && onlyChanges(['rf']))
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.st == 1 && request.resource.data.st == -2
            && request.time.toMillis() > resource.data.acc + 259200000
            && onlyChanges(['st']));
    }
  }
}
