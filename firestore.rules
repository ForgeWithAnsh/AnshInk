rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "forgewithansh@gmail.com"
        && request.auth.token.email_verified == true;
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{uid} {
      allow read, write: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    match /reviews/{rid} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.s is int
        && request.resource.data.s >= 1 && request.resource.data.s <= 5
        && request.resource.data.x.size() <= 500;
      allow delete: if isAdmin();
    }

    match /orders/{oid} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.st == 0;
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.st == 0 && request.resource.data.st == -4
            && onlyChanges(['st']))
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.st == 2 && request.resource.data.rf == 'req'
            && onlyChanges(['rf']))
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.st == 1 && request.resource.data.st == -2
            && request.time.toMillis() > resource.data.acc + 259200000
            && onlyChanges(['st']));
    }
  }
}
